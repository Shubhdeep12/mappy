# =============================================================================
# Frontend – copy this file to .env in this directory (packages/frontend/.env).
# Local dev: Vite proxies /api to backend; usually no .env needed.
# Production: set VITE_API_BASE_URL to your backend URL.
# =============================================================================

# Uncomment and set when backend is elsewhere (e.g. deployed URL)
# VITE_API_BASE_URL=http://localhost:8080/api
