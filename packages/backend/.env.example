# =============================================================================
# Backend – copy this file to .env in this directory (packages/backend/.env).
# API keys (Gemini, Google Maps) are entered by users in the app UI, not here.
# =============================================================================

NODE_ENV=development
PORT=8080
HOST=localhost

# CORS: frontend origin, or * for any
CORS_ORIGIN=*

# Gemini model when user supplies an API key (e.g. gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Free mode (when user does not supply keys): Ollama + OSM
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# OSM / free geocoding & routing (used when no Google Maps key)
OSRM_ENDPOINT=http://router.project-osrm.org
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Optional: rate limit and cache
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_BURST=3
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
