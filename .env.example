# =============================================================================
# Single reference for env vars (local dev or Vercel).
# Copy to .env for local dev. For Vercel: set these in Project → Settings → Environment Variables.
# =============================================================================
# Backend (API serverless function on Vercel reads these from process.env)
# -----------------------------------------------------------------------------
NODE_ENV=production
# CORS: allow your frontend origin (e.g. https://your-app.vercel.app) or * for any
CORS_ORIGIN=*

# Free mode: Ollama (local) + OSM. For Vercel, Ollama usually isn't available — users use Premium (Gemini + Google Maps) with API keys from the UI.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
GEMINI_MODEL=gemini-3.0-flash-preview

# OSM / free geocoding & routing (used when no Google Maps key)
OSRM_ENDPOINT=http://router.project-osrm.org
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Optional: rate limit and cache
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_BURST=3
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# Frontend (only needed if API is on a different origin; leave unset for same-origin Vercel)
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL=https://your-app.vercel.app/api
